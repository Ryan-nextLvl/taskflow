# =============================================================================
# TaskFlow — back-end
# Copie para backend/.env e preencha. Valores abaixo são FICTÍCIOS.
# =============================================================================
NODE_ENV=development
PORT=3333
# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Supabase: Project Settings > API Keys
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave SECRETA (sb_secret_...) ou a legada service_role. Somente no servidor!
SUPABASE_SECRET_KEY=sb_secret_substitua_pela_sua_chave_secreta

# Redis (local, Docker, Memurai ou Upstash com rediss://)
REDIS_URL=redis://localhost:6379
# Tempo de vida do cache do dashboard, em segundos
CACHE_TTL_SECONDS=60

# Token para acessar /api/diagnostics (mínimo 16 caracteres). Gere um aleatório:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DIAGNOSTICS_TOKEN=troque-por-um-token-aleatorio

# Fuso usado para calcular "atrasada", "vence hoje" e o gráfico diário
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info
